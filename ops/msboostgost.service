[Unit]
Description=MSBOOST isolated paid relay supervisor
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
User=msboostgost
Group=msboostgost
EnvironmentFile=/etc/msboostgost/node.env
ExecStart=/usr/bin/python3 /opt/msboost/relay.py
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=3
SendSIGKILL=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/msboostgost
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
