MSBOOST_ORIGIN=https://msboost.de
WORKER_TOKEN=replace-with-at-least-32-random-characters
WORKER_PORT=8788
MAX_JOBS=4
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_FROM=replace@qq.com
SMTP_USER=replace@qq.com
SMTP_PASSWORD=replace-with-smtp-authorization-code
MIHOMO_VERSION=v1.19.30
GOST_VERSION=v3.2.6
# Enable only after testing DD on a disposable VPS with a recovery console.
DD_ENABLED=false
REINSTALL_URL=https://raw.githubusercontent.com/bin456789/reinstall/main/reinstall.sh
# Optional reviewed entry-script hash. The upstream multi-stage assets still
# follow upstream behavior; pinning this script alone does not pin all stages.
REINSTALL_SHA256=
