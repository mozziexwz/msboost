# Use your worker hostname and issued TLS certificate paths.
server {
    listen 443 ssl;
    server_name worker.msboost.de;
    ssl_certificate /etc/letsencrypt/live/worker.msboost.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/worker.msboost.de/privkey.pem;
    client_max_body_size 32k;
    access_log off;
    location / {
        proxy_pass http://127.0.0.1:8788;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 25s;
    }
}
