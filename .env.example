# Runtime secrets: set in hosting environment, never commit real values.
PUBLIC_ORIGIN=https://msboost.de
OWNER_EMAIL=your-admin@qq.com
# Optional one-time administrator setup, at least 32 random characters.
# Enter it only in the initial administrator form; remove it after setup.
ADMIN_SETUP_TOKEN=
# 32 random bytes encoded as 64 hex characters. Keep an encrypted backup.
APP_ENCRYPTION_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# HTTPS endpoint for your own one-shot SSH worker / mail bridge.
WORKER_URL=
WORKER_TOKEN=
